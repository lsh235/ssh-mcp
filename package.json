{
  "name": "shell-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP development server with persistent OpenSSH shells",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/cli.js",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:ssh": "tsx --test --test-concurrency=1 test/ssh.integration.ts",
    "check": "npm run build && npm test && npm run test:ssh && npm run test:v02",
    "smoke": "node scripts/smoke.mjs",
    "test:soak": "tsx --test test/soak.integration.ts",
    "test:v02": "tsx --test --test-concurrency=1 test/features.integration.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "better-sqlite3": "13.0.3",
    "diff": "9.0.0",
    "express": "5.3.0",
    "jose": "6.2.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/diff": "7.0.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
