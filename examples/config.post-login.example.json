{
  "host": "127.0.0.1",
  "port": 8787,
  "publicUrl": "https://mcp.example.com/mcp",
  "allowedHosts": ["mcp.example.com", "127.0.0.1", "localhost"],
  "stateDir": "/home/mcp/.local/state/shell-mcp",
  "auth": { "mode": "token", "tokenEnv": "SHELL_MCP_TOKEN", "principal": "owner" },
  "targets": {
    "gated-dev": {
      "sshAlias": "gated-dev",
      "sshConfig": "/home/mcp/.ssh/config",
      "principals": ["owner"],
      "workspaces": { "app": "/srv/projects/app" },
      "postLogin": {
        "steps": [
          { "expect": "Login ID:", "valueFrom": { "file": "/home/mcp/.config/shell-mcp/gate-user" } },
          { "expect": "Access phrase:", "valueFrom": { "file": "/home/mcp/.config/shell-mcp/gate-password" } }
        ],
        "ready": "GATE_READY> ",
        "lineEnding": "lf",
        "timeoutMs": 10000
      }
    }
  }
}
